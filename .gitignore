# Shared snapshots and local caches stay on disk, outside version control.
/data/
/.cache/
.venv/
__pycache__/
*.py[cod]

# RAG is opt-in: retain implementation and small development inputs only.
/rag/*
!/rag/README.md
!/rag/context.md
!/rag/scripts/
!/rag/tests/
!/rag/experiments/
!/rag/eval/

# Approved dev/benchmark inputs and documentation; generated copies stay ignored.
/rag/eval/**
!/rag/eval/questions.json
!/rag/eval/questions_dev.json
!/rag/eval/README.md

/rag/scripts/*
!/rag/scripts/*.py
/rag/tests/*
!/rag/tests/*.py

/rag/experiments/**
!/rag/experiments/**/
!/rag/experiments/**/*.md
!/rag/experiments/dev_question_sample_20261013/selected_questions.json
!/rag/experiments/mvp/selection.json
!/rag/experiments/mvp/questions.jsonl
!/rag/experiments/mvp/local_api.json
!/rag/experiments/full/questions.jsonl
!/rag/experiments/full_validation_20261010/questions.jsonl
!/rag/experiments/generation_diagnosis/cases.jsonl
!/rag/experiments/generation_diagnosis/generation_profiles.json
!/rag/experiments/recovery/regression_cases.json
!/rag/experiments/publication_review_v3/excerpts.json

# Corpora, answers, audits, coverage reports and hash manifests are local artifacts.
/rag/data/

# Approved public review copies only; new reports/data remain opt-in.
!/rag/reports/
/rag/reports/**
!/rag/reports/README.md
!/rag/reports/data_access.md
!/rag/reports/manifest.json
