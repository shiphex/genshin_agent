# Shared raw data and local working artifacts.
/data/
/.cache/
.venv/
__pycache__/
*.py[cod]

# RAG is opt-in; data and generated outputs never enter Git.
/rag/*
!/rag/README.md
!/rag/context.md
!/rag/catalog.json
!/rag/config/
/rag/config/*
!/rag/config/local_api.json
!/rag/config/local_api.local.example.json
# Machine paths, device selection and endpoint overrides stay local.
/rag/config/*.local.json
!/rag/scripts/
/rag/scripts/*
!/rag/scripts/*.py
!/rag/tests/
/rag/tests/*
!/rag/tests/*.py
!/rag/docs/
/rag/docs/**
!/rag/docs/**/
!/rag/docs/**/*.md
!/rag/docs/recovery/regression_cases.json
!/rag/eval/
/rag/eval/*
!/rag/eval/README.md
!/rag/eval/questions.json
!/rag/eval/review20.json
!/rag/eval/smoke/
/rag/eval/smoke/*
!/rag/eval/smoke/README.md
!/rag/eval/smoke/questions.jsonl
/rag/data/
