# Shared snapshots and local caches stay on disk, outside version control.
/data/
/.cache/
.venv/
__pycache__/
*.py[cod]

# RAG is opt-in: retain implementation and small development inputs only.
/rag/*
!/rag/README.md
!/rag/context.md
!/rag/catalog.json
!/rag/scripts/
!/rag/tests/
!/rag/experiments/
!/rag/eval/
!/rag/config/
!/rag/docs/

# Shared local-service configuration and development documents.
/rag/config/*
!/rag/config/local_api.json
/rag/docs/**
!/rag/docs/**/
!/rag/docs/**/*.md
!/rag/docs/recovery/regression_cases.json

# Approved dev/benchmark inputs and documentation; generated copies stay ignored.
/rag/eval/**
!/rag/eval/questions.json
!/rag/eval/questions_dev.json
!/rag/eval/README.md
!/rag/eval/reviews/
!/rag/eval/reviews/dev_sample/
!/rag/eval/reviews/dev_sample/r001/
!/rag/eval/reviews/dev_sample/r001/selected_questions.json
!/rag/eval/reviews/dev_sample/r001/result_by_deepseek_summary.md

/rag/scripts/*
!/rag/scripts/*.py
/rag/tests/*
!/rag/tests/*.py

/rag/experiments/**
!/rag/experiments/**/
!/rag/experiments/**/*.md
!/rag/experiments/sample_retrieval/selection.json
!/rag/experiments/sample_retrieval/questions.jsonl
!/rag/experiments/full_retrieval/questions.jsonl
!/rag/experiments/model_comparison/questions.jsonl
!/rag/experiments/generation_diagnosis/cases.jsonl
!/rag/experiments/generation_diagnosis/generation_profiles.json

# Corpora, answers, audits, hashes, archive ZIPs and temporary work stay local.
/rag/data/

# Approved public review copies only; new reports/data remain opt-in.
!/rag/reports/
/rag/reports/**
!/rag/reports/README.md
!/rag/reports/data_access.md
!/rag/reports/manifest.json
!/rag/reports/model_comparison/
!/rag/reports/generation_diagnosis/
!/rag/reports/inputs/
!/rag/reports/inputs/excerpts_v3.json
!/rag/reports/model_comparison/r001/
!/rag/reports/model_comparison/r001/summary.md
!/rag/reports/model_comparison/r001/cases/
